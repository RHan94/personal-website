{
  // Static site served by Workers Static Assets (no Worker script needed)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  }
  // Cutover step: after verifying on workers.dev, delete the old A/AAAA records
  // for xuhan.dev in Cloudflare DNS, then uncomment:
  // "routes": [{ "pattern": "xuhan.dev", "custom_domain": true }]
}
