{
  // Static site served by Workers Static Assets; the Worker only handles /api/*
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // TODO before merging: replace id with the output of `wrangler kv namespace create HOLDINGS`
    { "binding": "HOLDINGS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "routes": [
    { "pattern": "xuhan.dev", "custom_domain": true },
    { "pattern": "www.xuhan.dev", "custom_domain": true }
  ]
}
